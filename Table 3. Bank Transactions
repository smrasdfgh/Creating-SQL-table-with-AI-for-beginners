CREATE TABLE bank_transaction (
  transaction_id BIGSERIAL PRIMARY KEY,
  account_id INTEGER NOT NULL REFERENCES bank_account(account_id),
  txn_timestamp TIMESTAMP NOT NULL,
  amount NUMERIC(14,2) NOT NULL,
  description VARCHAR(200) NOT NULL,
  reference VARCHAR(64) NOT NULL,
  direction CHAR(1) NOT NULL CHECK (direction IN ('C','D')),
  balance_after NUMERIC(14,2) NOT NULL,
  category VARCHAR(100) NOT NULL,
  counterparty_name VARCHAR(120),
  counterparty_account VARCHAR(64) NOT NULL,
  channel VARCHAR(10) NOT NULL CHECK (channel IN ('POS','ATM','Online')),
  status VARCHAR(10) NOT NULL CHECK (status IN ('posted','pending','reversed','rejected')),
  UNIQUE (account_id, reference)
  CONSTRAINT fk_txn_account FOREIGN KEY (account_id) REFERENCES bank_account(account_id),
  CONSTRAINT chk_txn_direction CHECK (direction IN ('C','D')),
  CONSTRAINT chk_txn_channel CHECK (channel IN ('POS','ATM','Online')),
  CONSTRAINT chk_txn_status CHECK (status IN ('posted','pending','reversed', 'rejected')),
  CONSTRAINT chk_txn_amount_sign CHECK (
    (direction = 'C' AND amount > 0) OR
    (direction = 'D' AND amount < 0)
  )
);

